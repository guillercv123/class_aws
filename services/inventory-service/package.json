{
  "name": "@orderflow/inventory-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --external:@aws-sdk/*",
    "predeploy": "pnpm build",
    "deploy": "serverless deploy",
    "predeploy:dev": "pnpm build",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --max-warnings 0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.8.0",
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@orderflow/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "serverless": "^4.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
